# Cấu hình tài khoản và URL Wealify
WEALIFY_BASE_URL=https://app.wealify.com
WEALIFY_USERNAME=your_account_email@domain.com
WEALIFY_PASSWORD=your_secure_password

# Chế độ chạy trình duyệt: false = hiện màn hình (khuyên dùng khi login lần đầu), true = ẩn màn hình
WEALIFY_HEADLESS=false

# Cấu hình thu thập
WEALIFY_OUTPUT_DIR=./output
WEALIFY_PAGE_LIMIT=0
WEALIFY_FULL_DRAWER=true

# Khoảng thời gian lọc (tuỳ chọn - định dạng DD/MM/YYYY)
WEALIFY_DATE_FROM=
WEALIFY_DATE_TO=

# Hỗ trợ tự động lấy OTP từ YOPmail (nếu tài khoản dùng email Yopmail)
WEALIFY_OTP_AUTO=false
WEALIFY_OTP_YOPMAIL_USER=
