# ---------------------------------------------------------------------------
# Nexa (WLF-01) configuration. Copy to .env and edit if needed.
# Never commit a real .env — it is git-ignored.
# ---------------------------------------------------------------------------

# Postgres (docker compose brings this up on 55432 by default)
NEXA_DATABASE_URL=postgresql://nexa:nexa@localhost:55432/nexa

# Local model via Ollama. A tool-capable model is preferred but not required:
#   ollama pull qwen3:8b        (native tool calling)
# Any chat model works through the JSON router, and with no model at all the
# assistant still answers from the deterministic engine.
NEXA_AI_URL=http://localhost:11434
# Running the stack in Docker? Ollama must listen on all interfaces for the
# container to reach it:   OLLAMA_HOST=0.0.0.0 ollama serve
NEXA_AI_MODEL=gemma4:latest
# Set to true to skip the model entirely (engine-only answers). Leave false:
# this is an AI product and the model is expected to be live.
NEXA_OFFLINE_MODE=false
# Transport failures are retried before the model is declared down.
NEXA_AI_RETRIES=2
NEXA_AI_RETRY_BACKOFF_SECONDS=0.75

# Mail. Confirmed report emails are sent through SMTP only; outbox delivery is
# disabled so missing SMTP configuration fails loudly instead of writing .eml.
NEXA_MAIL_MODE=smtp
NEXA_MAIL_TO=vaithieu0605@gmail.com
NEXA_SMTP_HOST=smtp.example.com
NEXA_SMTP_PORT=587
NEXA_SMTP_USER=nexa@example.com
NEXA_SMTP_PASSWORD=change-me
NEXA_SMTP_FROM=nexa@example.com
NEXA_SMTP_STARTTLS=true
NEXA_SMTP_SSL=false
NEXA_SMTP_TIMEOUT_SECONDS=20

# Vietnamese answers lead with đồng. This is a reference rate you control; it is
# never presented as a bank rate and every ₫ figure is marked approximate.
NEXA_USD_VND_RATE=26000
NEXA_SHOW_VND=true

# Daily monitoring re-scan (same code path as the manual scan).
NEXA_SCHEDULER_ENABLED=true
NEXA_SCAN_HOUR=7
