# ---------------------------------------------------------------------------
# Nexa (WLF-01) configuration. Copy to .env and edit if needed.
# Never commit a real .env — it is git-ignored.
# ---------------------------------------------------------------------------

# Postgres (docker compose brings this up on 55432 by default)
NEXA_DATABASE_URL=postgresql://nexa:nexa@localhost:55432/nexa

# The model endpoint. Two transports are supported and the choice comes from
# here alone:
#   * ollama  — a local daemon:            NEXA_AI_URL=http://localhost:11434
#   * openai  — any OpenAI-compatible API: .../v1  or  .../api/v3  (Ark, OpenAI,
#               Groq, Together, vLLM, llama.cpp server…)
# "auto" reads the URL shape and whether a key is set; force it if you prefer.
NEXA_AI_PROVIDER=auto
NEXA_AI_URL=http://localhost:11434
# Bearer token for a hosted endpoint. Leave empty for a local Ollama. Never
# commit this file — it is git-ignored for exactly this reason.
NEXA_AI_API_KEY=
NEXA_AI_MODEL=gemma4:latest
# Tool calling on an OpenAI-compatible endpoint: "auto" tries it and drops to
# JSON routing if the endpoint rejects the schema. "true"/"false" force it.
NEXA_AI_NATIVE_TOOLS=auto
# Running the stack in Docker with a LOCAL Ollama? It must listen on all
# interfaces for the container to reach it:  OLLAMA_HOST=0.0.0.0 ollama serve
# Set to true to skip the model entirely (engine-only answers). Leave false:
# this is an AI product and the model is expected to be live.
NEXA_OFFLINE_MODE=false
# Transport failures are retried before the model is declared down.
NEXA_AI_RETRIES=2
NEXA_AI_RETRY_BACKOFF_SECONDS=0.75

# Mail. Confirmed report emails are sent through SMTP only; outbox delivery is
# disabled so missing SMTP configuration fails loudly instead of writing .eml.
NEXA_MAIL_MODE=smtp
NEXA_MAIL_TO=vaithieu0605@gmail.com
NEXA_SMTP_HOST=smtp.example.com
NEXA_SMTP_PORT=587
NEXA_SMTP_USER=nexa@example.com
NEXA_SMTP_PASSWORD=change-me
NEXA_SMTP_FROM=nexa@example.com
NEXA_SMTP_STARTTLS=true
NEXA_SMTP_SSL=false
NEXA_SMTP_TIMEOUT_SECONDS=20

# Vietnamese answers lead with đồng. This is a reference rate you control; it is
# never presented as a bank rate and every ₫ figure is marked approximate.
NEXA_USD_VND_RATE=26000
NEXA_SHOW_VND=true

# Daily monitoring re-scan (same code path as the manual scan).
NEXA_SCHEDULER_ENABLED=true
NEXA_SCAN_HOUR=7

# YOPmail ingestion runs inside the backend APScheduler process.
NEXA_YOPMAIL_ENABLED=true
NEXA_YOPMAIL_USER=wealifytester
NEXA_YOPMAIL_MAILBOX=tester
NEXA_YOPMAIL_HOUR=7
NEXA_YOPMAIL_MINUTE=10
NEXA_YOPMAIL_NODE=node
NEXA_YOPMAIL_SCRAPER_DIR=./scripts/yopmail_scraper
NEXA_YOPMAIL_LIMIT=0
NEXA_YOPMAIL_DELAY_MS=800
NEXA_YOPMAIL_REQUIRE_UNLOCKED=true

# Which sample dataset to analyse. Defaults to ./dataset (the Wealify CSV
# export). Point it at backend/data/sample for the generated answer-key set.
# NEXA_DATA_DIR=./dataset

# Which mailbox in the export to analyse: tester, senior or junior. Empty
# picks the inbox registered against the cards in cards.csv.
# NEXA_MAILBOX=
